graylog:
  metrics:
    ## If true, prometheus annotations will be attached
    ##
    enabled: true
    serviceMonitor:
      enabled: true
      additionalLabels: {}
      scrapeTimeout: 10s
      interval: 10s
  rootUsername: "admin"
  rootPassword: "{{ k8s_secrets.graylog_root_password }}"
  input:
    tcp:
      service:
        name: graylog-tcp
        type: ClusterIP
      ports:
        - name: gelf
          port: 12221
    udp:
      service:
        name: graylog-udp
        type: ClusterIP
      ports:
        - name: syslog
          port: 12221         
